# ==============================================================================
# Email Scraper Pro — Environment Configuration
# ==============================================================================

# Port to bind server (default: 3000)
PORT=3000

# HUNTIQ CRM Integration (Server-Managed Only)
# NOTE: Never commit production API keys to source control.
HUNTIQ_API_URL=https://app.huntiq.com/api/v1/integrations/lead-ingest
HUNTIQ_API_KEY=hnt_live_your_secret_api_key_here
HUNTIQ_INTEGRATION_ENABLED=true

# Optional HUNTIQ Client Configuration
HUNTIQ_TIMEOUT_MS=10000
HUNTIQ_MAX_RETRIES=3

# Development / Testing Options
# When set to true, allows scraping localhost/127.0.0.1 for local test suites
ALLOW_LOCAL_SCRAPING=false
